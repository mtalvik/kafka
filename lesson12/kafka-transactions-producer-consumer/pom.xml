<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example.datacontracts</groupId>
  <artifactId>kafka-contracts-demo</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <modules>
    <module>producer-json</module>
    <module>producer-avro</module>
    <module>middle-aggregator</module>
    <module>end-consumer</module>
    <module>proto-contracts</module>
  </modules>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <kafka.version>3.7.0</kafka.version>
    <confluent.version>7.6.0</confluent.version>
    <jackson.version>2.17.0</jackson.version>
    <protobuf.version>3.25.3</protobuf.version>
  </properties>

  <repositories>
    <repository>
      <id>confluent</id>
      <url>https://packages.confluent.io/maven/</url>
    </repository>
  </repositories>
</project>